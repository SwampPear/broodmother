{
  "name": "@docs/root",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c magenta,cyan \"npm run dev -w @docs/server\" \"npm run dev -w @docs/web\"",
    "start": "concurrently -k -n server,web -c magenta,cyan \"npm run start -w @docs/server\" \"npm run start -w @docs/web\"",
    "build": "npm run typecheck && npm run build -w @docs/web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "jsdom": "^29.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-blockquote": "^3.29.2",
    "@tiptap/extension-bold": "^3.29.2",
    "@tiptap/extension-code": "^3.29.2",
    "@tiptap/extension-code-block": "^3.29.2",
    "@tiptap/extension-document": "^3.29.2",
    "@tiptap/extension-drag-handle-react": "^3.29.2",
    "@tiptap/extension-heading": "^3.29.2",
    "@tiptap/extension-horizontal-rule": "^3.29.2",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-italic": "^3.29.2",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/extension-list": "^3.29.2",
    "@tiptap/extension-paragraph": "^3.29.2",
    "@tiptap/extension-strike": "^3.29.2",
    "@tiptap/extension-table": "^3.29.2",
    "@tiptap/extension-text": "^3.29.2",
    "@tiptap/extensions": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/suggestion": "^3.29.2",
    "chokidar": "^5.0.0",
    "execa": "^10.0.0",
    "fuzzysort": "^3.1.0",
    "hono": "^4.12.32",
    "markdown-it": "^14.3.0",
    "next": "^16.2.12",
    "prosemirror-markdown": "^1.13.5",
    "prosemirror-model": "^1.25.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.1",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.31",
    "zod": "^4.4.3"
  }
}
