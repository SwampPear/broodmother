<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Chromium compiles JavaScript at runtime, which the hardened runtime forbids by default.
    Every Electron app needs these two.
  -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!--
    The app is ad-hoc signed, so its own libraries carry no team identity for the loader to
    match against its own. Library validation would refuse them — the pty is a native binary
    and would be the first to go — and the app would die on launch rather than open.
  -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
