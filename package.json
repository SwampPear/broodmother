{
  "name": "@mother/root",
  "private": true,
  "version": "0.1.0",
  "description": "A local-first documentation app — a cross between Obsidian and Notion",
  "license": "MIT",
  "homepage": "https://github.com/Proprium-Bioscience/mother#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Proprium-Bioscience/mother.git"
  },
  "keywords": [
    "markdown",
    "notes",
    "obsidian",
    "vault",
    "local-first",
    "editor"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "npm install && npm link",
    "dev": "concurrently -k -n server,web -c magenta,cyan \"npm run dev -w @mother/server\" \"npm run dev -w @mother/web\"",
    "start": "concurrently -k -n server,web -c magenta,cyan \"npm run start -w @mother/server\" \"npm run start -w @mother/web\"",
    "build": "npm run typecheck && npm run build -w @mother/web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test",
    "format": "prettier --write .",
    "build:npm": "node scripts/build-npm.mjs",
    "publish:npm": "npm run build:npm && npm publish dist-npm --access public"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "esbuild": "^0.28.1",
    "jsdom": "^29.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@hono/node-server": "^2.0.12",
    "@lezer/common": "^1.2.3",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2",
    "@lydell/node-pty": "^1.2.0-beta.14",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^5.0.0",
    "execa": "^10.0.0",
    "fuzzysort": "^3.1.0",
    "hono": "^4.12.32",
    "katex": "^0.18.1",
    "markdown-it": "^14.3.0",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "bin": {
    "mother": "./scripts/mother.mjs"
  }
}
